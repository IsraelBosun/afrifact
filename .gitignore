# ---- secrets ---------------------------------------------------------
# The studio holds the model key, the search key and the database service
# key. The app holds a Supabase URL and anon key, which are public by
# design but still not worth committing. The templates are the exception:
# they document the shape and carry no values.
.env
.env.*
!.env.example

# ---- dependencies and build output ----------------------------------
node_modules/
.next/
out/
build/
dist/
.expo/
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# ---- pipeline working files -----------------------------------------
# Fetched source documents, kept so the verifier can string-match a
# passage against the exact bytes the model saw. Not committed: they are
# verbatim full text of third-party articles, including copyrighted news
# pages, and `npm run fetch` rebuilds them.
_cache/

# Disposable stage output. Every run overwrites it wholesale. Anything
# that must survive a run lives in data/ instead — see lib/studio/quiz.js
# for what happens when that line gets blurred.
_generated/

# ---- local ----------------------------------------------------------
_scratch/
.claude/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
.vercel
/coverage
