# afrifacts-studio — the side that WRITES.
#
# Copy to `.env` and fill in. This file is the documented shape; `.env` is
# the real one and must never be shared or committed.
#
# This project holds every powerful key in AfriFacts, on purpose. The
# studio runs on your machine and talks to paid APIs and to the database
# with full rights. The app project holds none of them — see
# afrifacts/.env.example for why.

# ---- LLM ------------------------------------------------------------
# DeepSeek, OpenAI-compatible. The pipeline moved here from Gemini when
# the free tier's 20 requests/day stopped being workable.
DEEPSEEK_API_KEY=

# ---- Search ---------------------------------------------------------
# SerpApi, used by both source search and image search. Free tier is 250
# searches a month, shared between them, which is why every result is
# cached in data/ and a repeated query costs nothing.
SERPAPI_KEY=

# ---- Supabase -------------------------------------------------------
# Settings -> API in the Supabase dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely. It is
# a full database compromise if it leaks, and it belongs in this file and
# nowhere else. It must never appear in afrifacts/, where the bundler
# would inline it into the APK.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The schema the AfriFacts tables live in, so they are not mixed in with
# whatever else the project already serves out of `public`. It must also
# be added to Settings -> API -> Exposed schemas, or every query comes
# back as "relation does not exist".
SUPABASE_SCHEMA=afrifacts
