# afrifacts — the side that READS.
#
# Copy to `.env` and fill in.
#
# EVERY VALUE IN THIS FILE IS PUBLIC.
#
# Expo inlines EXPO_PUBLIC_* into the JavaScript bundle at build time.
# They ship inside the APK and anyone who downloads it can read them.
# That is fine for the two values below and fatal for anything else, so
# this file holds exactly these two and never grows:
#
#   - no DEEPSEEK_API_KEY
#   - no SERPAPI_KEY
#   - no SUPABASE_SERVICE_ROLE_KEY
#
# Those live in afrifacts-studio/.env. CLAUDE.md section 2.

# Settings -> API in the Supabase dashboard. Same project URL the studio
# uses; a different key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon key is designed to be published. It is not what protects the
# data — Row Level Security is. The anon role may only SELECT published
# rows from `facts` and `quiz_questions`, and cannot see the passages,
# reviews, sources or ledger at all.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
