{
  "name": "afrifacts-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content pipeline for AfriFacts. Turns sources into reviewed, publishable facts. No UI, no secrets in the app project.",
  "scripts": {
    "check": "tsx src/check.ts",
    "typecheck": "tsc --noEmit",
    "studio": "tsx src/studio/server.ts",
    "fetch": "tsx src/pipeline/fetch.ts",
    "extract": "tsx src/pipeline/extract.ts",
    "enrich": "tsx src/pipeline/enrich.ts",
    "approve": "tsx src/studio/approve-all.ts",
    "export": "tsx src/pipeline/export-to-app.ts",
    "images": "tsx src/pipeline/harvest-images.ts",
    "accept-images": "tsx src/studio/accept-all-images.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
